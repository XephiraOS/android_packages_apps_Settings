<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/xephira_card_margin_horizontal"
    android:paddingEnd="@dimen/xephira_card_margin_horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/xephira_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Glowing Xephira Emblem / Avatar Circle -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_xephira_halo_pulse">

            <ImageView
                android:id="@+id/xephira_hero_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_xephira_logo_badge"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Device & Identity Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/xephira_hero_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xephira Phone"
                android:textSize="17sp"
                android:fontFamily="@*android:string/config_headlineFontFamily"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/xephira_hero_version_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="XephiraOS 1.0 • Aether Edition"
                android:textSize="12sp"
                android:textColor="@color/xephira_neon_cyan"
                android:letterSpacing="0.02" />

            <!-- Live Status & Telemetry Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/xephira_hero_battery_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_glass_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="92% • Optimized"
                    android:textColor="@color/xephira_aurora_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/xephira_hero_security_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_settings_glass_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="Shield Protected"
                    android:textColor="@color/xephira_glass_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Forward Navigation Chevron -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right_24dp"
            android:tint="?android:attr/textColorSecondary" />

    </LinearLayout>
</FrameLayout>
