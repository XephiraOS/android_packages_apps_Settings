<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/xephira_card_margin_horizontal"
    android:paddingEnd="@dimen/xephira_card_margin_horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/xephira_sound_hero_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_glass_card"
        android:orientation="vertical"
        android:padding="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Top Header & Audio Engine Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/xephira_sound_hero_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_homepage_sound"
                android:tint="@color/xephira_neon_cyan"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="SPATIAL ACOUSTIC ENGINE"
                android:textColor="@color/xephira_glass_text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/xephira_sound_profile_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_glass_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Hi-Res 192kHz"
                android:textColor="@color/xephira_neon_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtitle & Acoustic Processing Mode -->
        <TextView
            android:id="@+id/xephira_sound_engine_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Adaptive Spatial Audio • Dolby Atmos &amp; Dirac"
            android:textColor="@color/xephira_color_white"
            android:textSize="15sp"
            android:fontFamily="@*android:string/config_headlineFontFamily"
            android:textStyle="bold" />

        <!-- Fluid Audio Visualizer Canvas View -->
        <com.android.settings.notification.XephiraAudioVisualizerView
            android:id="@+id/xephira_sound_visualizer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <!-- Acoustic Intelligence Feature Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Badge 1: Spatial Audio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:padding="8dp"
                android:gravity="center"
                android:background="@drawable/bg_settings_glass_pill"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="@color/xephira_aurora_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Spatial"
                    android:textColor="@color/xephira_glass_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Badge 2: Lossless HD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:padding="8dp"
                android:gravity="center"
                android:background="@drawable/bg_settings_glass_pill"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="@color/xephira_neon_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Dolby HD"
                    android:textColor="@color/xephira_glass_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Badge 3: O-Haptics -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:padding="8dp"
                android:gravity="center"
                android:background="@drawable/bg_settings_glass_pill"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="@color/xephira_crimson_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="O-Haptics"
                    android:textColor="@color/xephira_glass_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
